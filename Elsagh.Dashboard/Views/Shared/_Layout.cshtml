@{
    var nav = new (string Action, string Label, string Icon)[]
    {
        ("Index", "الرئيسية", "home"),
        ("Products", "المنتجات", "package"),
        ("Categories", "التصنيفات", "folder"),
        ("Manufacturing", "التصنيع", "factory"),
        ("RawGold", "الذهب الخام", "scale"),
        ("Suppliers", "الموردين", "truck"),
        ("Customers", "العملاء", "users"),
        ("Reports", "التقارير", "chart"),
        ("Settings", "الإعدادات", "settings")
    };
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة مصنع الصايغ</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <svg aria-hidden="true" class="icon-sprite">
        <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></symbol>
        <symbol id="i-package" viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z"/><path d="m4 7.5 8 4.5 8-4.5"/><path d="M12 12v9"/></symbol>
        <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></symbol>
        <symbol id="i-factory" viewBox="0 0 24 24"><path d="M3 21V9l6 4V9l6 4V5h5v16Z"/><path d="M7 17h2M12 17h2M17 17h2"/></symbol>
        <symbol id="i-scale" viewBox="0 0 24 24"><path d="M12 3v18"/><path d="M5 6h14"/><path d="m6 6-3 7h6Z"/><path d="m18 6-3 7h6Z"/></symbol>
        <symbol id="i-gem" viewBox="0 0 24 24"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M2 9h20"/><path d="m6 3 6 18 6-18"/></symbol>
        <symbol id="i-store" viewBox="0 0 24 24"><path d="M4 10h16"/><path d="M5 10l1-6h12l1 6"/><path d="M6 10v10h12V10"/><path d="M9 20v-5h6v5"/></symbol>
        <symbol id="i-boxes" viewBox="0 0 24 24"><path d="M3 7h8v8H3Z"/><path d="M13 3h8v8h-8Z"/><path d="M13 13h8v8h-8Z"/></symbol>
        <symbol id="i-cart" viewBox="0 0 24 24"><path d="M4 5h2l2 10h10l2-7H7"/><circle cx="10" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></symbol>
        <symbol id="i-coins" viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2"/><path d="M16 16a5 5 0 0 1 5 5"/></symbol>
        <symbol id="i-handshake" viewBox="0 0 24 24"><path d="M8 12 5 9l4-4 3 3"/><path d="m16 12 3-3-4-4-3 3"/><path d="M8 12l3 3a2 2 0 0 0 3 0l2-2"/><path d="m7 13 4-4"/></symbol>
        <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 6h12v10H3Z"/><path d="M15 10h4l2 3v3h-6Z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></symbol>
        <symbol id="i-badge" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><circle cx="12" cy="9" r="2"/><path d="M8 17a4 4 0 0 1 8 0"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M4 19h16"/><path d="m7 15 4-4 3 3 5-7"/></symbol>
        <symbol id="i-card" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 17 15 12 10 7"/><path d="M15 12H3"/><path d="M21 3v18"/></symbol>
    </svg>

    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a class="lux-logo" asp-controller="Dashboard" asp-action="Index" aria-label="مصنع الصايغ">
                    <img src="~/logo21.png" alt="شعار الصايغ" />
                </a>
                <div>
                    <strong>مصنع الصايغ</strong>
                    <span>للمجوهرات</span>
                    <small>نظام إدارة المصنع</small>
                </div>
            </div>

            <div class="sidebar-user-card">
                <span class="avatar">أ</span>
                <span class="online-dot"></span>
                <div>
                    <strong>أحمد الصايغ</strong>
                    <small>مدير النظام</small>
                </div>
            </div>

            <nav class="side-nav" aria-label="قائمة لوحة التحكم">
                @foreach (var item in nav)
                {
                    <a class="@(current == item.Action ? "active" : "")" asp-controller="Dashboard" asp-action="@item.Action">
                        <svg class="nav-icon"><use href="#i-@item.Icon"></use></svg>
                        <span>@item.Label</span>
                    </a>
                }
            </nav>

            <a class="sidebar-footer-card" asp-controller="Dashboard" asp-action="Index">
                <svg class="nav-icon"><use href="#i-logout"></use></svg>
                <div>
                    <strong>تسجيل الخروج</strong>
                    <small>إنهاء الجلسة الحالية</small>
                </div>
                <svg class="footer-chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </a>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-meta">
                    <button class="notify-button" type="button" aria-label="الإشعارات">
                        ♢
                        <small>5</small>
                    </button>
                    <button class="menu-button" type="button" aria-label="الإعدادات">⚙</button>
                </div>

                <label class="search-box">
                    <input placeholder="ابحث هنا..." />
                    <span>⌕</span>
                </label>

                <div class="topbar-tools">
                    <span class="date-chip">الأحد 26 يوليو 2025</span>
                    <button class="menu-button" type="button" aria-label="فتح القائمة">☰</button>
                </div>
            </header>

            @if (TempData["Message"] is string message)
            {
                <div class="toast">@message</div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
